# Nusxa oling: .env — va qiymatlarni o‘zingizga moslang

# production rejimida xavfsiz cookie (Secure) va HSTS yoqiladi
NODE_ENV=production
PORT=3000
# Server tinglaydigan manzil (production’da standart: 0.0.0.0)
# HOST=0.0.0.0

# Saytning haqiqiy manzili (canonical, sitemap, Open Graph uchun), oxirida / siz
SITE_URL=https://example.uz

# Nginx/Caddy yoki hosting proksisi ortida ishlasa 1 qiling (to‘g‘ri IP va HTTPS aniqlanishi uchun)
TRUST_PROXY=1

# Birinchi ishga tushirishda yaratiladigan administrator.
# Bo‘sh qoldirilsa, tasodifiy parol yaratilib data/BIRINCHI-KIRISH.txt fayliga yoziladi.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Ma’lumotlar bazasi: Supabase Postgres, Supavisor pooler (transaction mode, 6543-port).
# Barcha ma’lumotlar va yuklangan rasmlar shu bazada saqlanadi.
DATABASE_URL=postgresql://FOYDALANUVCHI.LOYIHA_REF:PAROL@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Jadvallar joylashadigan sxema (birinchi ishga tushishda avtomatik yaratiladi)
DB_SCHEMA=bilimziyo

# Sessiya cookie’larini imzolash kaliti (bir nechta server nusxasi bo‘lsa, majburiy)
SESSION_SECRET=

# Sessiya kaliti fayli va birinchi kirish fayli uchun lokal papka
DATA_DIR=data
